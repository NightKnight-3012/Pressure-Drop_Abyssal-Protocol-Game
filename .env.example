# Set these in the process/container environment (not automatically loaded).
PORT=3000
PD_DATA_FILE=server/data/pressure-drop.sqlite
MAX_ROOMS=20
MAX_ROOMS_PER_IP=4
MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_IP=40
# Only enable behind an operator-controlled proxy replacing forwarded IP headers.
TRUST_PROXY=false
# CORS_ORIGIN=https://your-game.example
